# Copia este archivo a .env y rellena los valores.

# --- Obligatorias (el servidor no arranca sin ellas) ---
MODEL_NAME=qwen2.5-vl-7b-instruct
LMSTUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
# Secreto para firmar la cookie de identidad del cliente (rate limit).
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# --- Opcionales (tienen valores por defecto en el código) ---
PORT=4000

# Protección de sobrecarga del modelo local compartido:
AI_MAX_CONCURRENCY=1              # llamadas simultáneas a LM Studio
AI_MAX_QUEUE=3                    # peticiones en cola antes de devolver 503
AI_REQUEST_TIMEOUT_MS=40000       # timeout por llamada (debe ser < 60s de nginx)
AI_QUEUE_TIMEOUT_MS=10000         # espera máxima en cola antes de descartar

# Límite por cliente:
AI_RATE_LIMIT_MAX=6              # preguntas por ventana
AI_RATE_LIMIT_WINDOW_MS=3600000  # ventana en ms (1 hora)

# Poner a false SOLO para pruebas locales por http (sin HTTPS):
COOKIE_SECURE=true
